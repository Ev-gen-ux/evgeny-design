{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio design tokens",
  "type": "object",
  "required": ["tokens", "contexts", "breakpoints", "runtime"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "description": {"type": "string"},
    "breakpoints": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "tokens": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$"},
      "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["rgbOf"], "additionalProperties": false, "properties": {"rgbOf": {"type": "string"}}}]}
    },
    "contexts": {
      "type": "array",
      "items": {"type": "object", "required": ["selector", "media", "declarations"], "additionalProperties": false,
        "properties": {"name": {"type": "string"}, "selector": {"type": "string"}, "media": {"type": "array", "items": {"type": "string"}}, "declarations": {"type": "object", "additionalProperties": {"type": "string"}}}
      }
    },
    "runtime": {"$ref": "#/$defs/runtimeValue"},
    "runtimeProperties": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "runtimeValue": {"oneOf": [
      {"type": ["string", "number", "boolean", "null"]},
      {"type": "array", "items": {"$ref": "#/$defs/runtimeValue"}},
      {"type": "object", "additionalProperties": {"$ref": "#/$defs/runtimeValue"}}
    ]}
  }
}
